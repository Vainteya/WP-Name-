# MongoDB connection string (free cluster: https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/supraj?retryWrites=true&w=majority
# Any long random string, used to sign admin login tokens
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
# Optional locally. On Vercel this is added automatically when you connect a Blob store.
# BLOB_READ_WRITE_TOKEN=
